---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { GrcWizardWrapper } from '../components/grc/GrcWizardWrapper';
import { TypewriterText } from '../components/TypewriterText';
---

<Layout 
  title="Diagnóstico GRC Gratuito - ¿Cumples con la Ley 21.663 y 21.719? | Áperca SpA"
  description="Evalúa en 2 minutos si tu empresa cumple con las nuevas leyes chilenas de ciberseguridad y protección de datos. Score de madurez + exposición económica indicativa."
>
  <Navbar />
  
  <!-- Hero Section - Marketing directo -->
  <section class="min-h-screen flex items-center justify-center bg-linear-to-br from-[#283329] to-[#0A0A0A] relative overflow-hidden">
    <div class="container mx-auto px-4 sm:px-6 relative z-10 py-20">
      <div class="max-w-4xl mx-auto">
        <!-- Bajada -->
        <h2 class="text-sm font-['JetBrains_Mono'] font-bold uppercase text-[#F99D1C] mb-8 text-center" style="letter-spacing: 0.02em; animation: fadeIn 0.6s ease;">
          Motor · Análisis · Riesgo
        </h2>

        <!-- Título Principal - Responsive -->
        <div class="relative mb-6 max-w-5xl mx-auto" style="animation: fadeIn 0.8s ease 0.2s both;">
          <!-- Mobile: apilado simple -->
          <div class="block lg:hidden text-center">
            <h1 class="text-3xl font-['Syne'] font-black leading-tight text-white mb-2" style="letter-spacing: -0.02em;">
              Nuestro motor mide riesgos<br/>
              <span class="text-[#F99D1C]">Nueva Ley de Datos</span>
            </h1>
          </div>

          <!-- Desktop: diseño vanguardista -->
          <div class="hidden lg:flex items-start gap-4">
            <div class="w-1/2 pt-8">
              <h1 class="text-xl xl:text-2xl font-['Syne'] font-black leading-tight text-white text-right pr-4" style="letter-spacing: -0.02em;">
                Nuestro motor mide<br/>riesgos de incumplimiento
              </h1>
            </div>
            <div class="w-1/2 pt-16">
              <h1 class="text-5xl xl:text-6xl font-['Syne'] font-black leading-none text-[#F99D1C]" style="letter-spacing: -0.02em;">
                Nueva Ley<br/>de Datos
              </h1>
            </div>
          </div>
        </div>
        
        <!-- Subtítulo - Urgencia + Beneficio con efecto typewriter -->
        <p class="font-['Space_Grotesk'] text-lg text-white/80 mb-10 max-w-3xl mx-auto leading-relaxed text-center" style="animation: fadeIn 0.8s ease 0.4s both; font-weight: 500; letter-spacing: 0.02em;">
          <TypewriterText 
            text="Evita sanciones millonarias y descubre la vulnerabilidad de tu infraestructura en 10 preguntas."
            speed={30}
            delay={400}
            client:load
          />
        </p>

        <!-- CTA Principal -->
        <div class="text-center mb-8">
          <button
            id="cta-open-panel"
            class="px-12 py-6 bg-[#F99D1C] text-[#283329] font-['Syne'] font-black text-2xl rounded-full transition-all duration-300 hover:scale-105 shadow-xl"
          >
            Comenzar Evaluación Gratuita →
          </button>
        </div>

        <!-- Trust bar simple -->
        <div class="text-center">
          <p class="text-sm text-white/50 font-['JetBrains_Mono']">
            Ley 21.663 (Ciberseguridad) · Ley 21.719 (Datos Personales)
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Panel Interactivo GRC - Modal con overlay oscuro y blur -->
  <div id="grc-panel" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-md overflow-y-auto">
    <div id="grc-panel-backdrop" class="min-h-screen flex items-center justify-center p-4 py-16">
      <div id="grc-panel-content" class="relative w-full max-w-2xl">
        <button
          id="grc-panel-close"
          aria-label="Cerrar"
          class="absolute -top-4 -right-4 z-10 w-10 h-10 rounded-full bg-white text-[#283329] flex items-center justify-center shadow-lg hover:scale-110 transition-transform text-lg font-bold"
        >
          ✕
        </button>
        <GrcWizardWrapper client:only="react" />
      </div>
    </div>
  </div>

  <!-- FAQ - Más compacto y al final -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-['Syne'] font-black text-center mb-12">
          Preguntas frecuentes
        </h2>
        
        <div class="space-y-6">
          <details class="border-b border-neutral-200 pb-4">
            <summary class="font-bold cursor-pointer">¿Es realmente gratis?</summary>
            <p class="text-neutral-600 text-sm mt-2">Sí. El diagnóstico exprés y el resultado son 100% gratuitos. La reunión de 30 minutos también es sin costo ni compromiso.</p>
          </details>
          
          <details class="border-b border-neutral-200 pb-4">
            <summary class="font-bold cursor-pointer">¿Qué tan preciso es el resultado?</summary>
            <p class="text-neutral-600 text-sm mt-2">Es una estimación indicativa basada en tus respuestas. En la reunión gratuita afinamos con datos reales de tu empresa para un informe detallado.</p>
          </details>
          
          <details class="border-b border-neutral-200 pb-4">
            <summary class="font-bold cursor-pointer">¿Qué pasa con mis datos?</summary>
            <p class="text-neutral-600 text-sm mt-2">Se usan solo para calcular tu diagnóstico y preparar la reunión si la agendas. No compartimos ni vendemos tu información.</p>
          </details>
          
          <details class="border-b border-neutral-200 pb-4">
            <summary class="font-bold cursor-pointer">¿Esto es asesoría legal?</summary>
            <p class="text-neutral-600 text-sm mt-2">No. Es un diagnóstico técnico de ciberseguridad y gobernanza de datos. Para asesoría legal, recomendamos consultar con un abogado especializado.</p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <Footer variant="clean" />

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btnOpenPanel = document.getElementById('cta-open-panel');
      const panel = document.getElementById('grc-panel');
      const panelBackdrop = document.getElementById('grc-panel-backdrop');
      const btnClosePanel = document.getElementById('grc-panel-close');

      const openPanel = () => {
        panel?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      };

      const closePanel = () => {
        panel?.classList.add('hidden');
        document.body.style.overflow = '';
      };

      if (btnOpenPanel && panel) {
        btnOpenPanel.addEventListener('click', openPanel);
      }

      if (btnClosePanel) {
        btnClosePanel.addEventListener('click', closePanel);
      }

      // Cerrar solo si el clic fue directamente sobre el backdrop (no un descendiente re-renderizado por React)
      panelBackdrop?.addEventListener('click', (e) => {
        if (e.target === panelBackdrop) {
          closePanel();
        }
      });

      // Cerrar con tecla Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && panel && !panel.classList.contains('hidden')) {
          closePanel();
        }
      });
    });
  </script>
</Layout>
