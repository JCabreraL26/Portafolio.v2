---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { LaboratorioScrollytelling } from '../components/laboratorio/LaboratorioScrollytelling';
import { TypewriterText } from '../components/TypewriterText';
---

<Layout 
  title="Servidor de Respaldo Local - Hardware que Renace, Datos que Perduran | Jorge Cabrera"
  description="De laptop en desuso a servidor headless 24/7. Debian + Docker + PostgreSQL. Infraestructura local para clientes que no pueden depender solo de la nube."
>
  <Navbar />
  
  <!-- Hero/Portada inicial -->
  <section class="min-h-screen flex items-center justify-center relative overflow-hidden bg-[#0A0A0A]">
    <!-- Imagen de fondo -->
    <img
      src="/img/laboratorio_hero_redes.jpg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-center z-0"
    />
    <!-- Overlay oscuro para contraste del texto -->
    <div class="absolute inset-0 z-[1]" style="background: linear-gradient(to bottom, rgba(10,10,10,0.45) 0%, rgba(10,10,10,0.25) 50%, rgba(10,10,10,0.6) 100%);"></div>
    <!-- Gradiente inferior: fade hacia el negro del carrusel -->
    <div class="absolute bottom-0 left-0 w-full h-48 z-[2]" style="background: linear-gradient(to bottom, transparent 0%, #0A0A0A 100%);"></div>
    <div class="container mx-auto px-4 sm:px-6 relative z-10 py-20">
      <div class="max-w-5xl mx-auto">
        <!-- Bajada -->
        <h2 class="text-sm font-['JetBrains_Mono'] font-bold uppercase text-[#F99D1C] mb-8 text-center" style="letter-spacing: 0.02em;">
          Respaldo local · Cumplimiento legal · Cero dependencia cloud
        </h2>

        <!-- Título Principal - Responsive -->
        <div class="relative mb-8 max-w-5xl mx-auto">
          <!-- Mobile: apilado simple -->
          <div class="block lg:hidden text-center">
            <h1 class="text-4xl font-['Syne'] font-black leading-tight text-white mb-2" style="letter-spacing: -0.02em;">
              ¿Qué pasa con los datos<br/>si la nube <span class="text-[#F99D1C]">falla</span>?
            </h1>
          </div>

          <!-- Desktop: diseño vanguardista -->
          <div class="hidden lg:flex items-center gap-4">
            <div class="w-1/2 flex items-center justify-end pr-4" style="min-height: 180px;">
              <h1 class="text-2xl xl:text-3xl font-['Syne'] font-black leading-tight text-white text-right" style="letter-spacing: -0.02em;">
                ¿Qué pasa con<br/>los datos si
              </h1>
            </div>
            <div class="w-1/2 flex items-center" style="min-height: 180px;">
              <h1 class="text-6xl xl:text-7xl font-['Syne'] font-black leading-none text-[#F99D1C]" style="letter-spacing: -0.02em;">
                la nube<br/>falla?
              </h1>
            </div>
          </div>
        </div>
        
        <!-- Subtítulo con animación tipo máquina -->
        <p class="text-xl text-white/70 mb-16 max-w-3xl mx-auto leading-relaxed text-center font-['Space_Grotesk'] font-medium" style="letter-spacing: 0.02em;">
          <TypewriterText 
            text="Creación de un servidor headless con Debian que respalda información, cumple con normativas de persistencia y elimina la dependencia total de la nube"
            speed={30}
            delay={800}
            client:load
          />
        </p>
      </div>
    </div>
  </section>

  <!-- Scrollytelling del Laboratorio -->
  <LaboratorioScrollytelling client:load />

  <Footer variant="clean" />
</Layout>
