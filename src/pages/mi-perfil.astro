---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { GLSLHills } from '../components/ui/GLSLHills';
---

<Layout title="Mi Perfil UX - Jorge Cabrera">
  <Navbar />
  
  <!-- Background GLSL Fixed (permanece fijo durante todo el scroll) -->
  <div class="fixed inset-0 z-0 bg-black">
    <div class="absolute inset-0 flex items-end">
      <div class="w-full h-[70vh]">
        <GLSLHills 
          client:load 
          variant="bright-red"
          speed={0.4}
          opacity={0.85}
          cameraZ={100}
        />
      </div>
    </div>
    <!-- Overlay oscuro para mejor legibilidad -->
    <div class="absolute inset-0 bg-black/40"></div>
  </div>

  <!-- Contenedor de créditos (todo el contenido sube) -->
  <div class="relative z-10">
    <!-- Espacio inicial vacío (para que el contenido empiece fuera de vista) -->
    <div class="h-screen"></div>

    <!-- Contenido que sube como créditos -->
    <div class="credits-container">
      
      <!-- Hero Title -->
      <section class="py-20 px-6">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="chaos-title mb-6">
            <span class="block text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-black text-white leading-tight" style="font-family: 'Syne', sans-serif; text-shadow: 0 4px 20px rgba(0,0,0,0.5);">
              Mi background es <span class="text-[#ff3333]">mi superpoder</span>
            </span>
          </h1>
          <p class="text-base sm:text-lg md:text-xl text-neutral-300 font-['Poppins'] max-w-2xl mx-auto" style="text-shadow: 0 2px 10px rgba(0,0,0,0.7);">
            Autodidacta. Analítico. Solopreneur.
          </p>
        </div>
      </section>

      <!-- Section 1: Filosofía -->
      <section class="py-20 px-6">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <!-- Imagen -->
            <div class="reveal-on-scroll" data-delay="0">
              <div class="relative rounded-3xl overflow-hidden shadow-2xl">
                <img 
                  src="/img/Jorge-Cabrera-Libros.jpg" 
                  alt="Filosofía y pensamiento crítico" 
                  class="w-full h-[400px] object-cover"
                />
                <div class="absolute top-6 right-6 bg-white/90 backdrop-blur-sm px-4 py-2 rounded-full text-sm font-semibold text-neutral-800">
                  Filosofía → UX
                </div>
              </div>
            </div>
            
            <!-- Texto -->
            <div class="reveal-on-scroll" data-delay="200">
              <div class="bg-white/10 backdrop-blur-md p-8 rounded-3xl border border-white/20">
                <h2 class="text-4xl font-black mb-4 text-white" style="font-family: 'Space Grotesk', sans-serif;">
                  De preguntas filosóficas<br/>a soluciones de diseño
                </h2>
                <p class="text-lg text-neutral-200 font-['Poppins'] leading-relaxed">
                  Años enseñando filosofía me entrenaron en hacer <strong>las preguntas correctas</strong>. 
                  Aprendí que entender el "por qué" es el primer paso para diseñar el "cómo".
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Pollitas -->
      <section class="py-20 px-6">
        <div class="max-w-5xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <!-- Imagen -->
            <div class="reveal-on-scroll" data-delay="0">
              <div class="relative rounded-3xl overflow-hidden shadow-2xl">
                <img 
                  src="/img/Aves-gestión.jpg" 
                  alt="Gestión avícola - La necesidad como maestra" 
                  class="w-full h-[400px] object-cover"
                />
              </div>
            </div>
            
            <!-- Texto -->
            <div class="reveal-on-scroll" data-delay="200">
              <div class="bg-white/10 backdrop-blur-md p-8 rounded-3xl border border-white/20">
                <h2 class="text-4xl font-black mb-4 text-white" style="font-family: 'Space Grotesk', sans-serif;">
                  La necesidad<br/>
                  <span class="text-[#ff3333]">como mejor maestra</span>
                </h2>
                <p class="text-lg text-neutral-200 font-['Poppins'] leading-relaxed">
                  Sin conocimientos previos en avicultura, fui al sur a criar aves. 
                  Crié planteles de pollitas durante 5 años. El campo me enseñó a <strong>aprender rápido y resolver problemas</strong> con lo que está a la mano.
                  Me hicieron falta en ese tiempo las habilidades UX que adquirí después. En simple: me adapto.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Quote Hölderlin -->
      <section class="py-32 px-6">
        <div class="max-w-4xl mx-auto text-center">
          <div class="reveal-on-scroll" data-delay="0">
            <blockquote class="text-3xl md:text-5xl lg:text-6xl font-black mb-8 text-[#F99D1C]" style="font-family: 'Space Grotesk', sans-serif; text-shadow: 0 4px 20px rgba(249,157,28,0.3);">
              <span id="typewriter-quote"></span>
            </blockquote>
            <p class="text-lg md:text-xl text-neutral-300 font-['Poppins'] italic">
              — Friedrich Hölderlin
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Cuatro Formas de Pensar -->
      <section class="py-32 px-6">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-5xl md:text-6xl font-black text-center mb-20 text-white reveal-on-scroll" style="font-family: 'Syne', sans-serif;">
            Cuatro formas de pensar
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Card 1: Pensamiento Crítico -->
            <div class="reveal-on-scroll" data-delay="0">
              <div class="bg-white/10 backdrop-blur-md p-8 rounded-3xl border border-white/20 h-full">
                <div class="flex justify-center mb-6">
                  <span class="text-5xl text-white font-['Space Grotesk'] font-black">Φ</span>
                </div>
                <h3 class="text-2xl font-bold mb-3 text-white font-['Space Grotesk']">Pensamiento Crítico</h3>
                <p class="text-neutral-200 font-['Poppins'] text-sm">
                  Hacía cursos de ética y filosofía en la universidad. Aprendí a cuestionar supuestos y buscar la verdad detrás de las apariencias.
                </p>
              </div>
            </div>
            
            <!-- Card 2: Pensamiento Estratégico -->
            <div class="reveal-on-scroll" data-delay="100">
              <div class="bg-white/10 backdrop-blur-md p-8 rounded-3xl border border-white/20 h-full">
                <div class="flex justify-center mb-6">
                  <span class="text-5xl text-white font-['Space Grotesk'] font-black">◆</span>
                </div>
                <h3 class="text-2xl font-bold mb-3 text-white font-['Space Grotesk']">Pensamiento Estratégico</h3>
                <p class="text-neutral-200 font-['Poppins'] text-sm">
                  Aprendí a gestionar un negocio desde cero con las pollitas. Recursos limitados, decisiones rápidas, adaptación constante.
                </p>
              </div>
            </div>
            
            <!-- Card 3: Pensamiento de Diseño -->
            <div class="reveal-on-scroll" data-delay="200">
              <div class="bg-white/10 backdrop-blur-md p-8 rounded-3xl border border-white/20 h-full">
                <div class="flex justify-center mb-6">
                  <span class="text-5xl text-white font-['Space Grotesk'] font-black">△</span>
                </div>
                <h3 class="text-2xl font-bold mb-3 text-white font-['Space Grotesk']">Pensamiento de Diseño</h3>
                <p class="text-neutral-200 font-['Poppins'] text-sm">
                  Mi experiencia en UX Design me enseñó a empatizar, prototipar rápido y validar con usuarios reales antes de construir.
                </p>
              </div>
            </div>
            
            <!-- Card 4: Pensamiento Hacker -->
            <div class="reveal-on-scroll" data-delay="300">
              <div class="bg-white/10 backdrop-blur-md p-8 rounded-3xl border border-white/20 h-full">
                <div class="flex justify-center mb-6">
                  <span class="text-5xl text-white font-['Space Grotesk'] font-black">⬡</span>
                </div>
                <h3 class="text-2xl font-bold mb-3 text-white font-['Space Grotesk']">Pensamiento Hacker</h3>
                <p class="text-neutral-200 font-['Poppins'] text-sm">
                  Ethical hacking y ciberseguridad. Pensar como un atacante para defender mejor. Encontrar vulnerabilidades antes que otros.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Contacto -->
      <section id="contacto" class="py-32 px-6">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-2xl xs:text-3xl sm:text-4xl md:text-5xl font-black font-['Syne'] mb-6 text-white leading-tight">
            Hablemos
          </h2>
          <p class="text-xl text-neutral-200 mb-12 max-w-2xl mx-auto leading-relaxed font-['Poppins']">
            No solo diseño. Resuelvo problemas. Con la lógica de un gestor y la empatía de un profesor.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <button 
              id="contact-button-perfil"
              class="px-8 py-4 border-2 border-white text-white font-semibold rounded-full transition-all hover:bg-[#ff3333] hover:border-[#ff3333] hover:scale-105"
            >
              Contacto
            </button>
            <a 
              href="https://linkedin.com/in/jorge-cabrera-ux" 
              target="_blank"
              rel="noopener noreferrer"
              class="px-8 py-4 border-2 border-white text-white font-semibold rounded-full transition-all hover:bg-[#ff3333] hover:border-[#ff3333] hover:scale-105 no-underline"
            >
              LinkedIn
            </a>
          </div>
        </div>
      </section>

      <!-- Espacio final vacío (para que el contenido termine fuera de vista) -->
      <div class="h-screen"></div>
      
    </div>
    <!-- Fin del contenedor de créditos -->
  </div>
</Layout>

<style>
  /* Animaciones de scroll reveal */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(50px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  .reveal-on-scroll.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Floating badges animation */
  .floating-badge {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0) rotate(12deg);
    }
    50% {
      transform: translateY(-20px) rotate(12deg);
    }
  }

  .floating-badge:last-child {
    animation-delay: 3s;
  }

  /* Floating elements animation */
  .floating-element {
    animation: animate-float 8s ease-in-out infinite;
  }

  @keyframes animate-float {
    0%, 100% {
      transform: translateY(0) translateX(0) scale(1);
    }
    33% {
      transform: translateY(-30px) translateX(20px) scale(1.1);
    }
    66% {
      transform: translateY(-15px) translateX(-15px) scale(0.95);
    }
  }

  /* Skill badges */
  .skill-badge {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, #f5f5f5 0%, #e5e5e5 100%);
    border: 2px solid #d4d4d4;
    border-radius: 2rem;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    color: #333;
    transition: all 0.3s ease;
  }

  .skill-badge:hover {
    background: linear-gradient(135deg, #b80000 0%, #950000 100%);
    color: white;
    border-color: #b80000;
    transform: translateY(-4px) rotate(2deg);
    box-shadow: 0 8px 20px rgba(184, 0, 0, 0.3);
  }

  /* Responsive adjustments */
  @media (max-width: 1024px) {
    .float-card {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      margin-bottom: 2rem;
    }
  }

  @media (max-width: 768px) {
    .chaos-title span {
      font-size: 2.5rem !important;
    }
    
    .floating-badge {
      font-size: 0.875rem;
      padding: 0.5rem 1rem;
    }
  }
</style>

<script>
  // Scroll reveal animation
  document.addEventListener('DOMContentLoaded', () => {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -100px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const delay = entry.target.getAttribute('data-delay') || '0';
          setTimeout(() => {
            entry.target.classList.add('revealed');
          }, parseInt(delay));
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('.reveal-on-scroll').forEach(el => {
      observer.observe(el);
    });

    // Botón de contacto
    const contactButton = document.getElementById('contact-button-perfil');
    if (contactButton) {
      contactButton.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('openChat', { 
          detail: { type: 'contact' } 
        }));
      });
    }

    // Typewriter effect para la quote de Hölderlin
    const typewriterElement = document.getElementById('typewriter-quote');
    const quoteText = "El hombre es un dios cuando sueña y un mendigo cuando reflexiona";
    
    if (typewriterElement) {
      let charIndex = 0;
      let isTyping = false;

      const typewriterObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !isTyping && typewriterElement) {
            isTyping = true;
            typewriterEffect();
            typewriterObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });

      if (typewriterElement) {
        typewriterObserver.observe(typewriterElement);
      }

      function typewriterEffect() {
        if (charIndex < quoteText.length && typewriterElement) {
          typewriterElement.textContent += quoteText.charAt(charIndex);
          charIndex++;
          setTimeout(typewriterEffect, 50); // Velocidad de escritura (50ms por carácter)
        }
      }
    }
  });
</script>

