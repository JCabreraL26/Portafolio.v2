<style>
  /* Scrollbar hide para el carrusel */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Smooth scroll para el carrusel */
  #reels-carousel {
    scroll-behavior: smooth;
  }
</style>

<script>
  // Carrusel de reels
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('reels-carousel');
    const prevBtn = document.getElementById('prev-reel');
    const nextBtn = document.getElementById('next-reel');

    if (carousel && prevBtn && nextBtn) {
      const scrollAmount = carousel.offsetWidth / 3;

      prevBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }
  });
</script>
