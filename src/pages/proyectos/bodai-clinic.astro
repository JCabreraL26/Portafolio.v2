---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout 
  title="Caso de Éxito: Bodai Clinic - Jorge Cabrera"
  description="Sistema SaaS de agendamiento con IA conversacional. Full Stack Engineering + UX Design + Growth Marketing con Meta Ads."
  image="/img/bodai-hero.jpg"
>
  <Navbar />
  
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-[#D4C5B0] via-[#E8DCC8] to-[#C9A96E]">
    <div class="absolute inset-0 bg-[url('/img/bodai-pattern.svg')] opacity-5"></div>
    
    <div class="container mx-auto px-4 sm:px-6 relative z-10 py-20">
      <div class="max-w-6xl mx-auto">
        <!-- Badge -->
        <div class="flex justify-center mb-8">
          <span class="inline-flex items-center gap-2 px-6 py-3 bg-white/20 backdrop-blur-sm rounded-full text-[#5A4A3A] font-semibold text-sm border border-[#C9A96E]/30">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            Proyecto Destacado 2025
          </span>
        </div>

        <!-- Título -->
        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-['Syne'] font-black text-center text-[#5A4A3A] leading-tight mb-6">
          Bodai Clinic
        </h1>
        
        <!-- Subtítulo -->
        <p class="text-xl sm:text-2xl md:text-3xl text-center text-[#5A4A3A]/80 font-light mb-8 max-w-4xl mx-auto">
          Sistema SaaS de Agendamiento con IA Conversacional
        </p>

        <!-- Tags de rol -->
        <div class="flex flex-wrap justify-center gap-3 mb-12">
          <span class="px-4 py-2 bg-[#C9A96E] text-white rounded-full text-sm font-semibold">Full Stack Engineer</span>
          <span class="px-4 py-2 bg-[#A88B5C] text-white rounded-full text-sm font-semibold">UX/UI Designer</span>
          <span class="px-4 py-2 bg-[#8B7355] text-white rounded-full text-sm font-semibold">Growth Marketer</span>
        </div>

        <!-- Métricas destacadas -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto">
          <div class="text-center p-6 bg-white/30 backdrop-blur-sm rounded-2xl border border-[#C9A96E]/20">
            <div class="text-4xl font-black text-[#5A4A3A] mb-2">+35%</div>
            <div class="text-sm text-[#5A4A3A]/70 font-medium">Leads Calificados</div>
          </div>
          <div class="text-center p-6 bg-white/30 backdrop-blur-sm rounded-2xl border border-[#C9A96E]/20">
            <div class="text-4xl font-black text-[#5A4A3A] mb-2">100K+</div>
            <div class="text-sm text-[#5A4A3A]/70 font-medium">Impresiones</div>
          </div>
          <div class="text-center p-6 bg-white/30 backdrop-blur-sm rounded-2xl border border-[#C9A96E]/20">
            <div class="text-4xl font-black text-[#5A4A3A] mb-2">3.05%</div>
            <div class="text-sm text-[#5A4A3A]/70 font-medium">CTR Promedio</div>
          </div>
          <div class="text-center p-6 bg-white/30 backdrop-blur-sm rounded-2xl border border-[#C9A96E]/20">
            <div class="text-4xl font-black text-[#5A4A3A] mb-2">$47.9</div>
            <div class="text-sm text-[#5A4A3A]/70 font-medium">CPC Optimizado</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- El Desafío -->
  <section class="py-20 bg-[#F8F5F0]">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-4xl sm:text-5xl font-['Syne'] font-black text-[#5A4A3A] mb-8">El Desafío</h2>
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <p class="text-lg text-[#5A4A3A]/80 mb-6 leading-relaxed">
              Bodai Clinic, clínica dental especializada en ortodoncia invisible Auraline, necesitaba un sistema de agendamiento automatizado que:
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[#C9A96E] flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-[#5A4A3A]/80">Gestionara múltiples ubicaciones (sede fija + itinerante)</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[#C9A96E] flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-[#5A4A3A]/80">Convirtiera visitantes en leads calificados</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[#C9A96E] flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-[#5A4A3A]/80">Redujera el costo de adquisición por paciente (CPA)</span>
              </li>
            </ul>
          </div>
          <div class="bg-white rounded-2xl p-8 shadow-xl border border-[#C9A96E]/10">
            <div class="aspect-video bg-gradient-to-br from-[#D4C5B0] to-[#C9A96E] rounded-xl flex items-center justify-center">
              <span class="text-white/50 text-sm">Screenshot del sistema</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mi Rol: Triple Impacto -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-4xl sm:text-5xl font-['Syne'] font-black text-[#5A4A3A] mb-4 text-center">Mi Rol: Triple Impacto</h2>
        <p class="text-xl text-[#5A4A3A]/60 text-center mb-16 max-w-3xl mx-auto">
          Lideré el proyecto desde tres perspectivas complementarias
        </p>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Full Stack Engineer -->
          <div class="bg-gradient-to-br from-[#C9A96E]/10 to-[#D4C5B0]/10 rounded-2xl p-8 border border-[#C9A96E]/20 hover:shadow-xl transition-all">
            <div class="w-16 h-16 bg-[#C9A96E] rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#5A4A3A] mb-4">Full Stack Engineer</h3>
            <ul class="space-y-3 text-[#5A4A3A]/70">
              <li class="flex items-start gap-2">
                <span class="text-[#C9A96E] mt-1">•</span>
                <span>Arquitectura Next.js 14 + Convex</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#C9A96E] mt-1">•</span>
                <span>Sistema RAG con Vector Search</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#C9A96E] mt-1">•</span>
                <span>Integración Gemini AI + Resend</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#C9A96E] mt-1">•</span>
                <span>12 tablas relacionales</span>
              </li>
            </ul>
          </div>

          <!-- UX/UI Designer -->
          <div class="bg-gradient-to-br from-[#A88B5C]/10 to-[#C9A96E]/10 rounded-2xl p-8 border border-[#A88B5C]/20 hover:shadow-xl transition-all">
            <div class="w-16 h-16 bg-[#A88B5C] rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#5A4A3A] mb-4">UX/UI Designer</h3>
            <ul class="space-y-3 text-[#5A4A3A]/70">
              <li class="flex items-start gap-2">
                <span class="text-[#A88B5C] mt-1">•</span>
                <span>Bento Grid de 5 secciones emocionales</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#A88B5C] mt-1">•</span>
                <span>Chat conversacional en 3 pasos</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#A88B5C] mt-1">•</span>
                <span>Design System con Tailwind</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#A88B5C] mt-1">•</span>
                <span>Animaciones Framer Motion</span>
              </li>
            </ul>
          </div>

          <!-- Growth Marketer -->
          <div class="bg-gradient-to-br from-[#8B7355]/10 to-[#A88B5C]/10 rounded-2xl p-8 border border-[#8B7355]/20 hover:shadow-xl transition-all">
            <div class="w-16 h-16 bg-[#8B7355] rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-[#5A4A3A] mb-4">Growth Marketer</h3>
            <ul class="space-y-3 text-[#5A4A3A]/70">
              <li class="flex items-start gap-2">
                <span class="text-[#8B7355] mt-1">•</span>
                <span>Campañas Meta Ads optimizadas</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B7355] mt-1">•</span>
                <span>Producción de Reels de alto engagement</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B7355] mt-1">•</span>
                <span>Funnels de conversión CRO</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B7355] mt-1">•</span>
                <span>Reducción de CPA</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stack Tecnológico -->
  <section class="py-20 bg-[#F8F5F0]">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-4xl sm:text-5xl font-['Syne'] font-black text-[#5A4A3A] mb-4 text-center">Stack Tecnológico</h2>
        <p class="text-xl text-[#5A4A3A]/60 text-center mb-16 max-w-3xl mx-auto">
          Arquitectura moderna con IA conversacional y backend escalable
        </p>

        <div class="grid md:grid-cols-2 gap-12">
          <!-- Frontend -->
          <div>
            <h3 class="text-2xl font-bold text-[#5A4A3A] mb-6 flex items-center gap-3">
              <span class="w-2 h-2 bg-[#C9A96E] rounded-full"></span>
              Frontend
            </h3>
            <div class="space-y-4">
              <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-[#C9A96E]/10">
                <div class="w-12 h-12 bg-[#C9A96E]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">⚛️</span>
                </div>
                <div>
                  <div class="font-semibold text-[#5A4A3A]">Next.js 14 + React 18</div>
                  <div class="text-sm text-[#5A4A3A]/60">App Router, TypeScript</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-[#C9A96E]/10">
                <div class="w-12 h-12 bg-[#C9A96E]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">🎨</span>
                </div>
                <div>
                  <div class="font-semibold text-[#5A4A3A]">Tailwind CSS</div>
                  <div class="text-sm text-[#5A4A3A]/60">Design System customizado</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-[#C9A96E]/10">
                <div class="w-12 h-12 bg-[#C9A96E]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">✨</span>
                </div>
                <div>
                  <div class="font-semibold text-[#5A4A3A]">Framer Motion</div>
                  <div class="text-sm text-[#5A4A3A]/60">Animaciones fluidas</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Backend & IA -->
          <div>
            <h3 class="text-2xl font-bold text-[#5A4A3A] mb-6 flex items-center gap-3">
              <span class="w-2 h-2 bg-[#C9A96E] rounded-full"></span>
              Backend & IA
            </h3>
            <div class="space-y-4">
              <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-[#C9A96E]/10">
                <div class="w-12 h-12 bg-[#C9A96E]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">🔷</span>
                </div>
                <div>
                  <div class="font-semibold text-[#5A4A3A]">Convex</div>
                  <div class="text-sm text-[#5A4A3A]/60">Backend-as-a-Service, 12 tablas</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-[#C9A96E]/10">
                <div class="w-12 h-12 bg-[#C9A96E]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">🤖</span>
                </div>
                <div>
                  <div class="font-semibold text-[#5A4A3A]">Google Gemini 1.5 Flash</div>
                  <div class="text-sm text-[#5A4A3A]/60">IA conversacional + RAG</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-[#C9A96E]/10">
                <div class="w-12 h-12 bg-[#C9A96E]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">📊</span>
                </div>
                <div>
                  <div class="font-semibold text-[#5A4A3A]">Vector Search</div>
                  <div class="text-sm text-[#5A4A3A]/60">Embeddings 768D nativos</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 bg-white rounded-xl border border-[#C9A96E]/10">
                <div class="w-12 h-12 bg-[#C9A96E]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">📧</span>
                </div>
                <div>
                  <div class="font-semibold text-[#5A4A3A]">Resend</div>
                  <div class="text-sm text-[#5A4A3A]/60">Email automation</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Resultados de Marketing -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-4xl sm:text-5xl font-['Syne'] font-black text-[#5A4A3A] mb-4 text-center">Resultados de Marketing</h2>
        <p class="text-xl text-[#5A4A3A]/60 text-center mb-16 max-w-3xl mx-auto">
          Gestión presupuestaria eficiente en Meta Ads con resultados superiores al benchmark
        </p>

        <!-- Métricas principales -->
        <div class="grid md:grid-cols-2 gap-8 mb-16">
          <div class="bg-gradient-to-br from-[#C9A96E]/10 to-[#D4C5B0]/10 rounded-2xl p-8 border border-[#C9A96E]/20">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-16 h-16 bg-[#C9A96E] rounded-2xl flex items-center justify-center">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
              </div>
              <div>
                <div class="text-4xl font-black text-[#5A4A3A]">+35%</div>
                <div class="text-sm text-[#5A4A3A]/60 font-medium">Incremento en Leads Calificados</div>
              </div>
            </div>
            <p class="text-[#5A4A3A]/70">
              Mediante la sinergia de pauta digital y contenido orgánico en video corto (Reels), reduciendo el costo de adquisición por paciente (CPA).
            </p>
          </div>

          <div class="bg-gradient-to-br from-[#A88B5C]/10 to-[#C9A96E]/10 rounded-2xl p-8 border border-[#A88B5C]/20">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-16 h-16 bg-[#A88B5C] rounded-2xl flex items-center justify-center">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </div>
              <div>
                <div class="text-4xl font-black text-[#5A4A3A]">100K+</div>
                <div class="text-sm text-[#5A4A3A]/60 font-medium">Impresiones Totales</div>
              </div>
            </div>
            <p class="text-[#5A4A3A]/70">
              Alcance masivo con gestión presupuestaria eficiente, maximizando la visibilidad de la marca en el mercado objetivo.
            </p>
          </div>
        </div>

        <!-- Métricas de rendimiento -->
        <div class="grid md:grid-cols-3 gap-6">
          <div class="text-center p-8 bg-[#F8F5F0] rounded-2xl">
            <div class="text-5xl font-black text-[#C9A96E] mb-3">3.05%</div>
            <div class="text-lg font-semibold text-[#5A4A3A] mb-2">CTR Promedio</div>
            <div class="text-sm text-[#5A4A3A]/60">Muy superior al benchmark de la industria</div>
          </div>
          <div class="text-center p-8 bg-[#F8F5F0] rounded-2xl">
            <div class="text-5xl font-black text-[#C9A96E] mb-3">$47.9</div>
            <div class="text-lg font-semibold text-[#5A4A3A] mb-2">CPC Optimizado</div>
            <div class="text-sm text-[#5A4A3A]/60">Costo por clic en pesos chilenos</div>
          </div>
          <div class="text-center p-8 bg-[#F8F5F0] rounded-2xl">
            <div class="text-5xl font-black text-[#C9A96E] mb-3">↓CPA</div>
            <div class="text-lg font-semibold text-[#5A4A3A] mb-2">Reducción de CPA</div>
            <div class="text-sm text-[#5A4A3A]/60">Costo de adquisición por paciente</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Galería de Reels -->
  <section class="py-20 bg-[#F8F5F0]">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-4xl sm:text-5xl font-['Syne'] font-black text-[#5A4A3A] mb-4 text-center">Contenido Producido</h2>
        <p class="text-xl text-[#5A4A3A]/60 text-center mb-16 max-w-3xl mx-auto">
          Reels editados profesionalmente para maximizar engagement y conversión
        </p>

        <!-- Carrusel de videos -->
        <div class="relative">
          <div id="reels-carousel" class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-8 scrollbar-hide">
            <!-- Reel 1 -->
            <div class="flex-shrink-0 w-full md:w-1/3 snap-center">
              <div class="bg-white rounded-2xl overflow-hidden shadow-xl border border-[#C9A96E]/10 group hover:shadow-2xl transition-all">
                <div class="aspect-[9/16] bg-gradient-to-br from-[#D4C5B0] to-[#C9A96E] relative overflow-hidden">
                  <!-- Placeholder para video -->
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="text-center">
                      <svg class="w-16 h-16 text-white/50 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
