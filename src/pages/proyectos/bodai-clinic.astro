---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout 
  title="Caso de Éxito: Bodai Clinic - Jorge Cabrera"
  description="Sistema SaaS de agendamiento con IA conversacional. Full Stack Engineering + UX Design + Growth Marketing con Meta Ads."
  image="Portada_Bodai_ar4_3.mp4"
>
  <Navbar />
  
  <!-- Hero Section con Parallax -->
  <section class="relative min-h-screen flex items-center justify-center">
    <!-- Video Background Fixed (Parallax) -->
    <video 
      src="/img/Portada_Bodai_ar4_3.mp4" 
      autoplay 
      loop 
      muted 
      playsinline
      class="fixed top-0 left-0 w-full h-screen object-cover z-0"
    >
    </video>
    <!-- Overlay suave para contraste del texto -->
    <div class="fixed top-0 left-0 w-full h-screen bg-gradient-to-b from-black/30 via-transparent to-black/40 z-[1]"></div>

    <div class="container mx-auto px-4 sm:px-6 relative z-10 py-20">
      <div class="max-w-6xl mx-auto">
        <!-- Título -->
        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-['Syne'] font-black text-center text-white leading-tight mb-6">
          Bodai Clinic
        </h1>
        
        <!-- Subtítulo -->
        <p class="text-xl sm:text-2xl md:text-3xl text-center text-white/90 font-light mb-8 max-w-4xl mx-auto">
          Sistema SaaS de Agendamiento con IA Conversacional
        </p>

        <!-- Tags de rol -->
        <div class="flex flex-wrap justify-center gap-3 mb-12">
          <span class="text-white text-sm font-semibold" style="text-shadow: 0 0 10px rgba(255,255,255,0.8), 0 0 20px rgba(255,255,255,0.5);">Full Stack Engineer</span>
          <span class="text-white text-sm font-semibold" style="text-shadow: 0 0 10px rgba(255,255,255,0.8), 0 0 20px rgba(255,255,255,0.5);">UX/UI Designer</span>
          <span class="text-white text-sm font-semibold" style="text-shadow: 0 0 10px rgba(255,255,255,0.8), 0 0 20px rgba(255,255,255,0.5);">Growth Marketer</span>
        </div>

        <!-- Métricas destacadas -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto mb-12">
          <div class="text-center p-6 bg-white/20 backdrop-blur-sm rounded-2xl border border-white/30">
            <div class="text-4xl font-black text-white mb-2">+35%</div>
            <div class="text-sm text-white/80 font-medium">Leads Calificados</div>
          </div>
          <div class="text-center p-6 bg-white/20 backdrop-blur-sm rounded-2xl border border-white/30">
            <div class="text-4xl font-black text-white mb-2">100K+</div>
            <div class="text-sm text-white/80 font-medium">Impresiones</div>
          </div>
          <div class="text-center p-6 bg-white/20 backdrop-blur-sm rounded-2xl border border-white/30">
            <div class="text-4xl font-black text-white mb-2">3.05%</div>
            <div class="text-sm text-white/80 font-medium">CTR Promedio</div>
          </div>
          <div class="text-center p-6 bg-white/20 backdrop-blur-sm rounded-2xl border border-white/30">
            <div class="text-4xl font-black text-white mb-2">$47.9</div>
            <div class="text-sm text-white/80 font-medium">CPC Optimizado</div>
          </div>
        </div>

        <!-- CTA Button -->
        <div class="flex justify-center">
          <a 
            href="https://www.clinicabodai.cl" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-8 py-4 bg-[#C9A96E] hover:bg-[#A88B5C] text-white font-bold text-lg rounded-full transition-all duration-300 shadow-2xl hover:shadow-[0_0_30px_rgba(201,169,110,0.6)] hover:scale-105"
          >
            <span>Ver Sitio en Producción</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- El Desafío -->
  <section class="relative z-20 py-20">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-4xl sm:text-5xl font-['Syne'] font-black text-white mb-8">El Desafío</h2>
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <p class="text-lg text-white/90 mb-6 leading-relaxed">
              Bodai Clinic, clínica dental especializada en ortodoncia invisible Auraline, necesitaba un sistema de agendamiento automatizado que:
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[#C9A96E] flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-white/90">Gestionara múltiples ubicaciones (sede fija + itinerante)</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[#C9A96E] flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-white/90">Convirtiera visitantes en leads calificados</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[#C9A96E] flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-white/90">Redujera el costo de adquisición por paciente (CPA)</span>
              </li>
            </ul>
          </div>
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-8 shadow-xl border border-white/20">
            <img src="/img/Bodai_saas_img.png" alt="Sistema SaaS Bodai Clinic - Agendamiento con IA" class="w-full rounded-xl">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mi Rol: Triple Impacto -->
  <section class="relative z-20 py-20">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-4xl sm:text-5xl font-['Syne'] font-black text-white mb-4 text-center">Mi Rol: Triple Impacto</h2>
        <p class="text-xl text-white/80 text-center mb-16 max-w-3xl mx-auto">
          Lideré el proyecto desde tres perspectivas complementarias
        </p>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Full Stack Engineer -->
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-8 border border-white/20 hover:shadow-xl transition-all">
            <div class="w-16 h-16 bg-[#C9A96E] rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">Full Stack Engineer</h3>
            <ul class="space-y-3 text-white/80">
              <li class="flex items-start gap-2">
                <span class="text-[#C9A96E] mt-1">•</span>
                <span>Arquitectura Next.js 14 + Convex</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#C9A96E] mt-1">•</span>
                <span>Sistema RAG con Vector Search</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#C9A96E] mt-1">•</span>
                <span>Integración Gemini AI + Resend</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#C9A96E] mt-1">•</span>
                <span>12 tablas relacionales</span>
              </li>
            </ul>
          </div>

          <!-- UX/UI Designer -->
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-8 border border-white/20 hover:shadow-xl transition-all">
            <div class="w-16 h-16 bg-[#A88B5C] rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">UX/UI Designer</h3>
            <ul class="space-y-3 text-white/80">
              <li class="flex items-start gap-2">
                <span class="text-[#A88B5C] mt-1">•</span>
                <span>Bento Grid de 5 secciones emocionales</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#A88B5C] mt-1">•</span>
                <span>Chat conversacional en 3 pasos</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#A88B5C] mt-1">•</span>
                <span>Design System con Tailwind</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#A88B5C] mt-1">•</span>
                <span>Animaciones Framer Motion</span>
              </li>
            </ul>
          </div>

          <!-- Growth Marketer -->
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-8 border border-white/20 hover:shadow-xl transition-all">
            <div class="w-16 h-16 bg-[#8B7355] rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">Growth Marketer</h3>
            <ul class="space-y-3 text-white/80">
              <li class="flex items-start gap-2">
                <span class="text-[#8B7355] mt-1">•</span>
                <span>Campañas Meta Ads optimizadas</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B7355] mt-1">•</span>
                <span>Producción de Reels de alto engagement</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B7355] mt-1">•</span>
                <span>Funnels de conversión CRO</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#8B7355] mt-1">•</span>
                <span>Reducción de CPA</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stack Tecnológico -->
  <section class="relative z-20 py-20">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-4xl sm:text-5xl font-['Syne'] font-black text-white mb-4 text-center">Stack Tecnológico</h2>
        <p class="text-xl text-white/80 text-center mb-16 max-w-3xl mx-auto">
          Arquitectura moderna con IA conversacional y backend escalable
        </p>

        <div class="grid md:grid-cols-2 gap-12">
          <!-- Frontend -->
          <div>
            <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
              <span class="w-2 h-2 bg-white rounded-full"></span>
              Frontend
            </h3>
            <div class="space-y-4">
              <div class="flex items-center gap-4 p-4 bg-white/10 backdrop-blur-md rounded-xl border border-white/20">
                <div class="w-12 h-12 bg-[#C9A96E]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">⚛️</span>
                </div>
                <div>
                  <div class="font-semibold text-white">Next.js 14 + React 18</div>
                  <div class="text-sm text-white/70">App Router, TypeScript</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 bg-white/10 backdrop-blur-md rounded-xl border border-white/20">
                <div class="w-12 h-12 bg-[#C9A96E]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">🎨</span>
                </div>
                <div>
                  <div class="font-semibold text-white">Tailwind CSS</div>
                  <div class="text-sm text-white/70">Design System customizado</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 bg-white/10 backdrop-blur-md rounded-xl border border-white/20">
                <div class="w-12 h-12 bg-[#C9A96E]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">✨</span>
                </div>
                <div>
                  <div class="font-semibold text-white">Framer Motion</div>
                  <div class="text-sm text-white/70">Animaciones fluidas</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Backend & IA -->
          <div>
            <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
              <span class="w-2 h-2 bg-white rounded-full"></span>
              Backend & IA
            </h3>
            <div class="space-y-4">
              <div class="flex items-center gap-4 p-4 bg-white/10 backdrop-blur-md rounded-xl border border-white/20">
                <div class="w-12 h-12 bg-[#C9A96E]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">🔷</span>
                </div>
                <div>
                  <div class="font-semibold text-white">Convex</div>
                  <div class="text-sm text-white/70">Backend-as-a-Service, 12 tablas</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 bg-white/10 backdrop-blur-md rounded-xl border border-white/20">
                <div class="w-12 h-12 bg-[#C9A96E]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">🤖</span>
                </div>
                <div>
                  <div class="font-semibold text-white">Google Gemini 1.5 Flash</div>
                  <div class="text-sm text-white/70">IA conversacional + RAG</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 bg-white/10 backdrop-blur-md rounded-xl border border-white/20">
                <div class="w-12 h-12 bg-[#C9A96E]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">📊</span>
                </div>
                <div>
                  <div class="font-semibold text-white">Vector Search</div>
                  <div class="text-sm text-white/70">Embeddings 768D nativos</div>
                </div>
              </div>
              <div class="flex items-center gap-4 p-4 bg-white/10 backdrop-blur-md rounded-xl border border-white/20">
                <div class="w-12 h-12 bg-[#C9A96E]/10 rounded-lg flex items-center justify-center">
                  <span class="text-2xl">📧</span>
                </div>
                <div>
                  <div class="font-semibold text-white">Resend</div>
                  <div class="text-sm text-white/70">Email automation</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Resultados de Marketing -->
  <section class="relative z-20 py-20">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-4xl sm:text-5xl font-['Syne'] font-black text-white mb-4 text-center">Resultados de Marketing</h2>
        <p class="text-xl text-white/80 text-center mb-16 max-w-3xl mx-auto">
          Gestión presupuestaria eficiente en Meta Ads con resultados superiores al benchmark
        </p>

        <!-- Métricas principales -->
        <div class="grid md:grid-cols-2 gap-8 mb-16">
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-8 border border-white/20">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-16 h-16 bg-[#C9A96E] rounded-2xl flex items-center justify-center">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
              </div>
              <div>
                <div class="text-4xl font-black text-white">+35%</div>
                <div class="text-sm text-white/70 font-medium">Incremento en Leads Calificados</div>
              </div>
            </div>
            <p class="text-white/80">
              Mediante la sinergia de pauta digital y contenido orgánico en video corto (Reels), reduciendo el costo de adquisición por paciente (CPA).
            </p>
          </div>

          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-8 border border-white/20">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-16 h-16 bg-[#A88B5C] rounded-2xl flex items-center justify-center">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </div>
              <div>
                <div class="text-4xl font-black text-white">100K+</div>
                <div class="text-sm text-white/70 font-medium">Impresiones Totales</div>
              </div>
            </div>
            <p class="text-white/80">
              Alcance masivo con gestión presupuestaria eficiente, maximizando la visibilidad de la marca en el mercado objetivo.
            </p>
          </div>
        </div>

        <!-- Métricas de rendimiento -->
        <div class="grid md:grid-cols-3 gap-6">
          <div class="text-center p-8 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20">
            <div class="text-5xl font-black text-white mb-3">3.05%</div>
            <div class="text-lg font-semibold text-white mb-2">CTR Promedio</div>
            <div class="text-sm text-white/70">Muy superior al benchmark de la industria</div>
          </div>
          <div class="text-center p-8 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20">
            <div class="text-5xl font-black text-white mb-3">$47.9</div>
            <div class="text-lg font-semibold text-white mb-2">CPC Optimizado</div>
            <div class="text-sm text-white/70">Costo por clic en pesos chilenos</div>
          </div>
          <div class="text-center p-8 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20">
            <div class="text-5xl font-black text-white mb-3">↓CPA</div>
            <div class="text-lg font-semibold text-white mb-2">Reducción de CPA</div>
            <div class="text-sm text-white/70">Costo de adquisición por paciente</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Galería de Reels -->
  <section class="relative z-20 py-20">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-4xl sm:text-5xl font-['Syne'] font-black text-white mb-4 text-center">Contenido Producido</h2>
        <p class="text-xl text-white/80 text-center mb-16 max-w-3xl mx-auto">
          Reels editados profesionalmente para maximizar engagement y conversión
        </p>

        <!-- Carrusel de videos -->
        <div class="relative">
          <div id="reels-carousel" class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-8 scrollbar-hide">
            <!-- Reel 1 -->
            <div class="flex-shrink-0 w-full md:w-1/3 snap-center">
              <div class="bg-white/10 backdrop-blur-md rounded-2xl overflow-hidden shadow-xl border border-white/20 group hover:shadow-2xl transition-all">
                <div class="aspect-[9/16] relative overflow-hidden">
                  <video
                    src="/img/2_Auraline_asífunciona.mp4"
                    autoplay
                    loop
                    muted
                    playsinline
                    class="absolute inset-0 w-full h-full object-cover"
                  ></video>
                </div>
                <div class="p-6">
                  <h3 class="font-bold text-white mb-2">Auraline - Así funciona</h3>
                  <p class="text-sm text-white/70">Explicación del proceso de ortodoncia invisible</p>
                </div>
              </div>
            </div>

            <!-- Reel 2 -->
            <div class="flex-shrink-0 w-full md:w-1/3 snap-center">
              <div class="bg-white/10 backdrop-blur-md rounded-2xl overflow-hidden shadow-xl border border-white/20 group hover:shadow-2xl transition-all">
                <div class="aspect-[9/16] relative overflow-hidden">
                  <video
                    src="/img/3_adios_flacidez_javi_editado.mp4"
                    autoplay
                    loop
                    muted
                    playsinline
                    class="absolute inset-0 w-full h-full object-cover"
                  ></video>
                </div>
                <div class="p-6">
                  <h3 class="font-bold text-white mb-2">Adiós Flacidez - Javi</h3>
                  <p class="text-sm text-white/70">Transformación y testimonio de paciente</p>
                </div>
              </div>
            </div>

            <!-- Reel 3 -->
            <div class="flex-shrink-0 w-full md:w-1/3 snap-center">
              <div class="bg-white/10 backdrop-blur-md rounded-2xl overflow-hidden shadow-xl border border-white/20 group hover:shadow-2xl transition-all">
                <div class="aspect-[9/16] relative overflow-hidden">
                  <video
                    src="/img/Reel 9 Bodai (Testimonios final).mp4"
                    autoplay
                    loop
                    muted
                    playsinline
                    class="absolute inset-0 w-full h-full object-cover"
                  ></video>
                </div>
                <div class="p-6">
                  <h3 class="font-bold text-white mb-2">Testimonios Finales</h3>
                  <p class="text-sm text-white/70">Experiencias reales de pacientes de Bodai</p>
                </div>
              </div>
