---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { BentoGridSecurity } from '../../components/projects/BentoGridSecurity';
---

<Layout 
  title="Ciberseguridad Empresarial - Protección que Previene Crisis | Jorge Cabrera"
  description="Ciberseguridad nivel enterprise para empresas que no pueden permitirse brechas de datos. Pentesting ético, cumplimiento normativo, estándares OSSTMM y NIST."
>
  <Navbar />
  
  <!-- Hero Section con Background Image -->
  <section class="relative min-h-screen flex items-center justify-center">
    <!-- Background Image Fixed -->
    <div 
      class="fixed top-0 left-0 w-full h-screen bg-cover bg-center bg-no-repeat z-0"
      style="background-image: url('/img/Logo aperca brutalista.jpg');"
    >
    </div>
    <!-- Overlay para contraste del texto -->
    <div class="fixed top-0 left-0 w-full h-screen bg-gradient-to-b from-black/60 via-black/40 to-black/70 z-[1]"></div>

    <div class="container mx-auto px-4 sm:px-6 relative z-10 py-20">
      <div class="max-w-6xl mx-auto text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-[#FF6B35]/30 border border-[#FF6B35]/50 rounded-full mb-8 backdrop-blur-sm">
          <svg class="w-5 h-5 text-[#FF6B35]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span class="text-[#FF6B35] text-sm font-semibold">Ciberseguridad Enterprise</span>
        </div>

        <!-- Título Principal -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-['Syne'] font-black leading-tight mb-6" style="color: #F99D1C; text-shadow: 0 0 20px rgba(249, 157, 28, 0.8), 0 0 40px rgba(249, 157, 28, 0.4), 0 2px 20px rgba(0,0,0,0.8);">
          Protección Empresarial que<br/>
          Previene Crisis de Reputación
        </h1>
        
        <!-- Subtítulo -->
        <p class="text-xl sm:text-2xl text-white font-light mb-12 max-w-4xl mx-auto leading-relaxed" style="text-shadow: 0 2px 15px rgba(0,0,0,0.9);">
          Ciberseguridad nivel enterprise para empresas que no pueden permitirse brechas de datos ni caídas de sistema
        </p>

        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto mb-16">
          <div class="text-center p-6 bg-black/60 backdrop-blur-md rounded-2xl border border-white/20 shadow-xl">
            <div class="text-3xl font-black text-white mb-2">72h</div>
            <div class="text-sm text-white/80 font-medium">Diagnóstico Completo</div>
          </div>
          <div class="text-center p-6 bg-black/60 backdrop-blur-md rounded-2xl border border-white/20 shadow-xl">
            <div class="text-3xl font-black text-white mb-2">0</div>
            <div class="text-sm text-white/80 font-medium">Brechas de Datos</div>
          </div>
          <div class="text-center p-6 bg-black/60 backdrop-blur-md rounded-2xl border border-white/20 shadow-xl">
            <div class="text-3xl font-black text-white mb-2">100%</div>
            <div class="text-sm text-white/80 font-medium">Cumplimiento Legal</div>
          </div>
          <div class="text-center p-6 bg-black/60 backdrop-blur-md rounded-2xl border border-white/20 shadow-xl">
            <div class="text-3xl font-black text-white mb-2">24/7</div>
            <div class="text-sm text-white/80 font-medium">Monitoreo Continuo</div>
          </div>
        </div>

        <!-- Scroll Indicator -->
        <div class="flex flex-col items-center gap-2 animate-bounce">
          <span class="text-white/60 text-sm">Descubre cómo protegemos tu empresa</span>
          <svg class="w-6 h-6 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Bento Grid Section -->
  <section class="relative z-20 py-20 bg-[#FAF9F6]">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-7xl mx-auto">
        <!-- Section Header -->
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-['Syne'] font-black text-[#0A0A0A] mb-4">
            Ciberseguridad que Protege tu Negocio
          </h2>
          <p class="text-lg text-neutral-600 max-w-3xl mx-auto">
            No vendemos tecnología, vendemos tranquilidad. Cada medida de seguridad está diseñada para proteger lo que más importa: tu reputación, tus clientes y tu negocio.
          </p>
        </div>

        <!-- Bento Grid Component (Isla de React) -->
        <BentoGridSecurity client:visible />
      </div>
    </div>
  </section>

  <!-- Credenciales y Formación -->
  <section class="relative z-20 py-20 bg-white">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-['Syne'] font-black text-[#0A0A0A] mb-12 text-center">
          Formación Continua en Ciberseguridad
        </h2>
        
        <div class="grid md:grid-cols-2 gap-8">
          <!-- Certificaciones -->
          <div class="bg-white rounded-2xl p-8 border border-neutral-200 shadow-sm">
            <h3 class="text-xl font-bold text-[#0A0A0A] mb-6 flex items-center gap-2">
              <span class="text-2xl">🎓</span>
              Certificaciones
            </h3>
            
            <div class="space-y-4">
              <!-- Cisco Badge -->
              <div class="flex items-start gap-4 p-4 bg-[#FAF9F6] rounded-xl">
                <img 
                  src="/img/networking-basics.png" 
                  alt="Cisco Networking Basics" 
                  class="w-16 h-16 object-contain flex-shrink-0"
                />
                <div>
                  <p class="font-bold text-[#0A0A0A]">Cisco Network Basics</p>
                  <p class="text-sm text-neutral-600 mt-1">Fundamentos de redes y seguridad</p>
                </div>
              </div>
              
              <!-- Ethical Hacking -->
              <div class="flex items-start gap-4 p-4 bg-[#FAF9F6] rounded-xl">
                <div class="w-16 h-16 bg-[#FF6B35] rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-[#0A0A0A]">Ethical Hacking</p>
                  <p class="text-sm text-neutral-600 mt-1">En formación continua</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Stack de Pentesting -->
          <div class="bg-white rounded-2xl p-8 border border-neutral-200 shadow-sm">
            <h3 class="text-xl font-bold text-[#0A0A0A] mb-6 flex items-center gap-2">
              <span class="text-2xl">⚡</span>
              Stack de Pentesting
            </h3>
            
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <span class="text-[#FF6B35] text-lg mt-0.5">▸</span>
                <div>
                  <p class="font-bold text-[#0A0A0A]">Kali Linux</p>
                  <p class="text-sm text-neutral-600">Plataforma principal de pentesting</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-[#FF6B35] text-lg mt-0.5">▸</span>
                <div>
                  <p class="font-bold text-[#0A0A0A]">Nmap, Burp Suite, Metasploit</p>
                  <p class="text-sm text-neutral-600">Análisis de vulnerabilidades</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-[#FF6B35] text-lg mt-0.5">▸</span>
                <div>
                  <p class="font-bold text-[#0A0A0A]">OWASP Top 10</p>
                  <p class="text-sm text-neutral-600">Metodología de testing</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="relative z-20 py-20 bg-gradient-to-br from-[#0A0A0A] to-[#1a1a1a]">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-['Syne'] font-black text-white mb-6">
          ¿Listo para Proteger tu Empresa?
        </h2>
        <p class="text-xl text-white/80 mb-12 max-w-2xl mx-auto">
          Diagnóstico de seguridad gratuito: identificamos tus 3 vulnerabilidades críticas en 72 horas.
        </p>
        <button
          id="cta-security-audit"
          class="px-8 py-4 bg-gradient-to-r from-[#FF6B35] to-[#FF8C42] text-white font-bold text-lg rounded-full transition-all duration-300 shadow-2xl hover:shadow-[0_0_30px_rgba(255,107,53,0.6)] hover:scale-105 inline-flex items-center gap-3"
        >
          <span>Solicitar Auditoría de Seguridad</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <Footer variant="clean" />

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const ctaButton = document.getElementById('cta-security-audit');
      if (ctaButton) {
        ctaButton.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('openChat', { 
            detail: { type: 'general' } 
          }));
        });
      }
    });
  </script>
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  section {
    animation: fadeInUp 0.8s ease-out;
  }
</style>
